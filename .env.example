# ==============================================================================
# GTA6-ZeroHour Environment Configuration
# ==============================================================================

# Gemini 3.8 Flash API Key (Never hardcode or commit keys)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model name: default is gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Long-Video Chunking & Rate Limiting
# Splits long videos into manageable chunks for Gemini Files API analysis
CHUNK_MINUTES=30

# Delay in seconds between chunk calls to respect free-tier rate limits (429 prevention)
MOMENTS_DELAY_SECONDS=5

# Default maximum number of top moments to extract per video
MAX_MOMENTS=10

# Maximum section extraction window in seconds (default: 1800s = 30 mins)
MAX_EXTRACT_SECONDS=1800

# Server Security Controls (Set to 1 in cloud containers like Railway/Docker)
ALLOW_ALL_HOSTS=0

# Operator Access Key (Required for Login & API access)
# The login page requires this key to unlock the dashboard
ACCESS_KEY=Javelloui*~*.Yrs->2004

# OpenRouter Free LLM Highlights Engine
# Get free API keys at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
